# Copy this file to .env.local (which IS gitignored) and fill in real values.
# .env.local is loaded automatically by Next.js and our test runner via process.env.

# Which AI provider the /api/process route uses for the categorisation
# fallback. Accepted values:
#   mock       — deterministic stub, no network, no API key needed (default)
#   anthropic  — live Claude Haiku via @anthropic-ai/sdk (costs money)
AI_PROVIDER=mock

# Anthropic API key for the AI categorisation fallback (module 4c-2).
# Only required when AI_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/. Never commit the real value.
ANTHROPIC_API_KEY=

# Set to "true" to opt in to the live Anthropic test under
# __tests__/categorizer/ai/live/ (costs real money). Default: unset (skipped).
ENABLE_LIVE_AI_TESTS=

# Which CBS provider to use. Accepted values:
#   mock  — local JSON fixtures, no network, deterministic (default)
#   live  — Open Data API at opendata.cbs.nl (table 86141NED)
# In production: set to "live". For local dev: "mock" keeps things fast
# and avoids hammering CBS during testing.
CBS_PROVIDER=mock

# Set to "true" to log user corrections to lib/categorizer/data/
# user-corrections.log. Used locally to spot patterns for expanding
# keywords.ts. NEVER enable in production — log contains raw transaction
# descriptions from real users. Default: unset (no logging).
CORRECTIONS_LOG_ENABLED=

# Set to "true" to opt in to the live CBS test suite under
# __tests__/cbs/live/ (hits real CBS API). Default: unset (skipped).
ENABLE_LIVE_CBS_TESTS=
